# 复制为 .env.local 后填值。生产用 `vercel env` 管理，对照表见 docs/deployment.md。
#
# ⚠️ NEXT_PUBLIC_* 是**构建期内联**的：改这类变量后必须重新部署才生效。

# ── LLM 解读层（命理+心理 双声部）—— provider 无关，双线协议 ──
# 切换模型只需改这几个环境变量，无需改代码。

# 默认：MiniMax-M3 Coding/Token Plan（Anthropic 兼容线协议）
LLM_PROVIDER=minimax              # minimax | deepseek | openai-compatible | anthropic-compatible
LLM_MODEL=MiniMax-M3
# base 预设已含默认值，可省略；MiniMax 默认 https://api.minimax.io/anthropic（中国区改 api.minimaxi.com/anthropic）
# LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_API_KEY=                      # ⚠️ MiniMax Coding/Token Plan 订阅 key（sk-cp…），platform.minimax.io 获取
# 也兼容生态既有变量：ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL（anthropic 线协议时自动读取）
# LLM_CACHE=false                 # prompt 缓存（anthropic 线），默认开

# 备选 provider 示例（OpenAI 兼容线协议）：
# LLM_PROVIDER=deepseek  LLM_MODEL=deepseek-chat  LLM_API_KEY=...
# 任意端点：LLM_PROVIDER=openai-compatible  LLM_WIRE=openai  LLM_BASE_URL=https://.../v1  LLM_MODEL=xxx  LLM_API_KEY=...

# 注：紫微安星法**不读环境变量**。它是 packages/core/src/ziwei/index.ts 的函数
# 默认参数（'zhongzhou' 中州派）。本文件此前列的 ZIWEI_ALGORITHM 是死配置，已删。

# ── Supabase（档案存储，匿名登录 + RLS）──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # 可公开的 publishable key（非 service_role）
SUPABASE_SERVICE_ROLE_KEY=                          # ⚠️ 仅限 route handler，绕过 RLS，绝不可进客户端包

# ── Telegram Bot / Mini App ──
TELEGRAM_BOT_TOKEN=               # ⚠️ 未配置时 `next build` 会在 /api/tg/webhook 的 page-data 收集阶段失败
TELEGRAM_WEBHOOK_SECRET=          # webhook 校验 + TG session cookie 的 HMAC 签名密钥
NEXT_PUBLIC_TG_BOT_USERNAME=your_bot
NEXT_PUBLIC_MINIAPP_URL=https://your-domain
# TG_QUOTA_DISABLED=1             # 关闭 TG 侧配额（灰度用）
# CRON_SECRET=                    # /api/tg/cron 的调用凭据

# ── 功能开关（默认全关；=1 开启）──
# NEXT_PUBLIC_SPIRIT_ENABLED=1    # 本命之灵
# NEXT_PUBLIC_FENGSHUI_ENABLED=1  # 风水「境」
# BILLING_ENABLED=1               # 会员闸门总开关。⚠️ 没有 NEXT_PUBLIC_ 前缀，
                                  # 客户端读不到，故页面须向服务端探测权益；
                                  # 不为 "1"（默认）时不做任何限制。
